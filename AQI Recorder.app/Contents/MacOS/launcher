#!/bin/zsh

APP_ROOT="/Users/devalopr/Documents/Projects/Portable-AQI-recorder"
PORT="8080"
URL="http://localhost:${PORT}"
LOG_FILE="/tmp/aqi-recorder-web.log"

cd "$APP_ROOT" || exit 1

if ! /usr/sbin/lsof -nP -iTCP:${PORT} -sTCP:LISTEN | /usr/bin/grep -q LISTEN; then
  PYTHON_BIN="$(command -v python3)"
  if [ -z "$PYTHON_BIN" ]; then
    /usr/bin/osascript -e 'display alert "AQI Recorder" message "python3 was not found. Install Python 3 or run the web app manually."'
    exit 1
  fi

  /usr/bin/nohup "$PYTHON_BIN" -m http.server "$PORT" --directory web > "$LOG_FILE" 2>&1 &
  sleep 1
fi

/usr/bin/open "$URL"
